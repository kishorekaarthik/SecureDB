SECUREDB_ENV=dev
SECUREDB_DATABASE_URL=postgresql+psycopg://securedb_app:CHANGE_ME_APP@localhost:5432/securedb
SECUREDB_MIGRATION_DATABASE_URL=postgresql+psycopg://securedb_owner:CHANGE_ME_OWNER@localhost:5432/securedb
SECUREDB_LOG_LEVEL=INFO
# Master key: "keychain" (OS credential store) or "file" (passphrase-protected key file)
SECUREDB_MASTER_KEY_STORE=keychain
# With the file store also set:
# SECUREDB_MASTER_KEY_FILE=securedb-master.key
# SECUREDB_MASTER_KEY_PASSPHRASE=
# AWS KMS as the master key (needs `uv sync --extra kms` and AWS credentials):
# SECUREDB_MASTER_KEY_STORE=kms
# SECUREDB_KMS_KEY_ID=arn:aws:kms:ap-south-1:111122223333:key/...
# SECUREDB_KMS_REGION=ap-south-1
# Limits (defaults shown)
# SECUREDB_RATE_LIMIT_PER_MINUTE=600
# SECUREDB_LOGIN_ATTEMPTS_PER_MINUTE=10
# SECUREDB_MAX_BODY_BYTES=1048576
